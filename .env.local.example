# =============================================================================
# Local Supabase Dev Mode
# =============================================================================
# Set to "local" to use local Supabase Docker stack (no cloud dependency)
# Remove or set to "cloud" for production Supabase
NEXT_PUBLIC_SUPABASE_MODE=local

# Local Supabase keys (from `npx supabase start` output)
NEXT_PUBLIC_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_LOCAL_ANON_KEY=<paste anon key from supabase start>
SUPABASE_LOCAL_SERVICE_ROLE_KEY=<paste service_role key from supabase start>

# =============================================================================
# Cloud Supabase (production)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-cloud-anon-key

# =============================================================================
# AI API Keys
# =============================================================================
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Stripe
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
